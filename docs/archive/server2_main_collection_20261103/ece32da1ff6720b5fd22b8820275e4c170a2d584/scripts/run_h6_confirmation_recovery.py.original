"""H6-only newly approved run; default scope only. Never reuses a spent grant."""
import argparse
import json
import h6_confirmation_recovery_contract as c


def main():
    p=argparse.ArgumentParser();g=p.add_mutually_exclusive_group()
    for name in ('execute','supervise','audit','evaluate'):g.add_argument('--'+name,action='store_true')
    p.add_argument('--config');a=p.parse_args()
    if not any((a.execute,a.supervise,a.audit,a.evaluate)):
        print(json.dumps(dict(status='SCOPE_ONLY',stage='H6_CONFIRMATION',new_approval_required=True)));return 0
    try:
        cfg=c.read(a.config);c.authorize(cfg)
        from h6_confirmation_recovery_runtime import get_runtime,evaluate
        if a.evaluate:evaluate(cfg);return 0
        rt=get_runtime(cfg)
        if a.supervise:return rt.runner.supervise(cfg,a.config)
        if a.audit:return int(bool(rt.auditor.audit(cfg)['errors']))
        c.require(c.read(cfg['supervisor']['entered'])==dict(SOURCE=cfg['SOURCE'],plan_sha256=cfg['plan_sha256'],grant_id=cfg['grant']['grant_id'],retry=False),'H6_EXTERNAL_SUPERVISOR_REQUIRED')
        return rt.runner.execute(cfg)
    except Exception as exc:print(json.dumps(dict(status='REFUSED',reason=str(exc),retry=False)));return 2

if __name__=='__main__':raise SystemExit(main())
