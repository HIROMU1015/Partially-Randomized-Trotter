"""Artificial inputs only: no saved arrays, science runner, compile or sampling."""
from fractions import Fraction
import importlib.util
from pathlib import Path

import numpy as np
import pytest
from qiskit import QuantumCircuit
from qiskit.quantum_info import Statevector
from scipy.linalg import expm

ROOT = Path(__file__).resolve().parents[1]
spec = importlib.util.spec_from_file_location("cng_diag", ROOT/"src/trotterlib/cng_gaussian_diagnostics.py")
d = importlib.util.module_from_spec(spec)
spec.loader.exec_module(d)


def rotation(theta):
    return np.array([[np.cos(theta), -np.sin(theta)],
                     [np.sin(theta), np.cos(theta)]], dtype=complex)


def sandwich(basis, eigenvalues, time, squared=False):
    circuit = QuantumCircuit(2)
    circuit.compose(basis.inverse(), inplace=True)
    diagonal = np.array([0, eigenvalues[0], eigenvalues[1], sum(eigenvalues)])
    if squared:
        diagonal = diagonal**2
    from qiskit.circuit.library import DiagonalGate
    circuit.append(DiagonalGate(np.exp(-1j*time*diagonal)), [0, 1])
    circuit.compose(basis, inplace=True)
    return circuit


def legacy_basis(u):
    from qiskit_nature.second_q.circuit.library import BogoliubovTransform
    return BogoliubovTransform(u.T)


def test_legacy_cutoff_can_fail_one_G_while_square_passes():
    # An artificial opposite-eigenvalue degeneracy after squaring.  It is not
    # an assertion that any molecular fragment has these eigenvalues.
    u = rotation(7e-9)
    eigenvalues = np.array([1., -1.])
    matrix = u@np.diag(eigenvalues)@u.conj().T
    initial = np.array([0., 1., 0., 0.], dtype=complex)
    expected = initial.copy()
    expected[1:3] = expm(-.4j*matrix)@initial[1:3]
    old = Statevector(initial).evolve(sandwich(legacy_basis(u), eigenvalues, .4)).data
    new = Statevector(initial).evolve(sandwich(d.diagnostic_gaussian_candidate(u), eigenvalues, .4)).data
    assert np.linalg.norm(old-expected) > 1e-9
    assert np.linalg.norm(new-expected) < 1e-14
    square = Statevector(initial).evolve(sandwich(legacy_basis(u), eigenvalues, .4, True)).data
    assert np.linalg.norm(square-initial*np.exp(-.4j)) < 1e-14


def test_arccos_loses_a_small_nonzero_rotation():
    angle = 2e-8
    cosine = 1/np.hypot(1., angle)
    assert abs(np.arccos(cosine)-np.arctan2(angle, 1.)) > 1e-10
    g = d.stable_givens(1., angle)
    assert abs(g[0, 1]-angle/np.hypot(1., angle)) < 1e-22


@pytest.mark.parametrize("theta", [0., 1e-12, 7e-9, 2e-8, .31, 1.2])
def test_candidate_preserves_one_particle_matrix_and_vacuum(theta):
    u = rotation(theta)
    circuit = d.diagnostic_gaussian_candidate(u)
    actual = np.column_stack([Statevector.from_int(i, 4).evolve(circuit).data[[1, 2]] for i in [1, 2]])
    assert np.linalg.norm(actual-u) < 1e-14
    assert np.linalg.norm(Statevector.from_int(0, 4).evolve(circuit).data-np.eye(4)[0]) < 1e-14


def test_complex_multimode_and_fermionic_signs_without_phase_fit():
    # Fixed artificial 4-mode unitary and its exterior-power action, all sectors.
    seed_matrix = np.array([[1,2j,3,4j],[2,3,5j,7],[4j,1,2,3],[1,2,4,9j]], dtype=complex)
    u, _ = np.linalg.qr(seed_matrix)
    circuit = d.diagnostic_gaussian_candidate(u)
    for index in range(16):
        occupied = [i for i in range(4) if (index>>i)&1]
        expected = np.zeros(16, dtype=complex)
        for target in range(16):
            rows = [i for i in range(4) if (target>>i)&1]
            if len(rows) == len(occupied):
                expected[target] = np.linalg.det(u[np.ix_(rows, occupied)]) if rows else 1
        assert np.linalg.norm(Statevector.from_int(index, 16).evolve(circuit).data-expected) < 1e-13


def test_negative_time_and_scalar_phase_are_not_aligned_away():
    u = rotation(.31)
    initial = np.array([0., 1., 0., 0.], dtype=complex)
    a = sandwich(d.diagnostic_gaussian_candidate(u), [1., -.4], .4)
    b = sandwich(d.diagnostic_gaussian_candidate(u), [1., -.4], -.4)
    assert np.linalg.norm(Statevector(initial).evolve(a).evolve(b).data-initial) < 1e-13
    with_phase = a.copy(); with_phase.global_phase += .125
    assert np.linalg.norm(Statevector(initial).evolve(a).data-Statevector(initial).evolve(with_phase).data) > .1


def test_representative_match_does_not_establish_entire_law():
    rare = Fraction(1, 10**8)
    native = {"common": Fraction(1), "rare": Fraction(1)}
    compiled = {"common": Fraction(1), "rare": Fraction(-1)}
    assert native["common"] == compiled["common"]
    assert ((1-rare)*native["common"]+rare*native["rare"]
            != (1-rare)*compiled["common"]+rare*compiled["rare"])


def test_ceil_boundary_and_missing_independent_N():
    assert d.ceil_interval(Fraction(999,100), Fraction(1000,100))["integer"] == 10
    assert d.ceil_interval(Fraction(999,100), Fraction(1001,100))["integer"] is None
    assert d.ceil_interval(Fraction(1000,100), Fraction(1001,100))["status"] == "CEIL_UNRESOLVED"


@pytest.mark.parametrize("a,b", [(0.,0.), (0.,1e-20), (1.,1e-12), (1j,2+3j)])
def test_givens_unitarity_and_zeroing(a,b):
    g = d.stable_givens(a,b)
    assert np.linalg.norm(g.conj().T@g-np.eye(2)) < 1e-14
    assert abs((g@np.array([a,b]))[1]) < 1e-14


def test_invalid_candidate_inputs_fail_closed():
    for u in [np.zeros((2,2)), np.array([[np.nan,0],[0,1]]), np.ones((2,3))]:
        with pytest.raises(ValueError): d.diagnostic_gaussian_candidate(u)
    with pytest.raises(ValueError): d.stable_givens(float("inf"), 0)
    with pytest.raises(ValueError): d.two_mode_lift(np.zeros((2,2)))
    with pytest.raises(ValueError): d.ceil_interval(0, 1)
