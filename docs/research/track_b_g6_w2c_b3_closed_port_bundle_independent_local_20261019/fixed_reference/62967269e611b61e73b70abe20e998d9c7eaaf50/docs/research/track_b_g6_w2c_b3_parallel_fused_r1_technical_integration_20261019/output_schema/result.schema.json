{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:b3:parallel:v3:result",
  "type": "object",
  "properties": {
    "schema": {
      "const": "b3_parallel_result_v3"
    },
    "settings": {
      "type": "object"
    },
    "planned": {
      "type": "integer",
      "minimum": 0
    },
    "reserved": {
      "type": "integer",
      "minimum": 0
    },
    "started_observed": {
      "type": "integer",
      "minimum": 0
    },
    "states": {
      "type": "object",
      "properties": {
        "NOT_STARTED": {
          "type": "integer",
          "minimum": 0
        },
        "START_RESERVED": {
          "type": "integer",
          "minimum": 0
        },
        "STARTED": {
          "type": "integer",
          "minimum": 0
        },
        "IN_FLIGHT": {
          "type": "integer",
          "minimum": 0
        },
        "COMPLETED": {
          "type": "integer",
          "minimum": 0
        },
        "FAILED": {
          "type": "integer",
          "minimum": 0
        },
        "CANCELLED_BEFORE_START": {
          "type": "integer",
          "minimum": 0
        },
        "TERMINATED_WITH_UNKNOWN_RESULT": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "NOT_STARTED",
        "START_RESERVED",
        "STARTED",
        "IN_FLIGHT",
        "COMPLETED",
        "FAILED",
        "CANCELLED_BEFORE_START",
        "TERMINATED_WITH_UNKNOWN_RESULT"
      ],
      "additionalProperties": false
    },
    "complete": {
      "type": "boolean"
    },
    "pairs": {
      "type": "array",
      "items": {
        "$ref": "urn:b3:parallel:v3:pair"
      }
    },
    "parent_cpu_ns": {
      "type": "integer",
      "minimum": 0
    },
    "worker_cpu_ns": {
      "type": "integer",
      "minimum": 0
    },
    "total_cpu_ns": {
      "type": "integer",
      "minimum": 0
    },
    "wall_ns": {
      "type": "integer",
      "minimum": 0
    },
    "failures": {
      "type": "array"
    },
    "all_pair_states": {
      "type": "object"
    },
    "output": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object"
        },
        "reserved": {
          "type": "object"
        },
        "observed": {
          "type": "object"
        }
      },
      "required": [
        "limits",
        "reserved",
        "observed"
      ],
      "additionalProperties": true
    },
    "mandatory_STOP": {
      "const": true
    },
    "retry": {
      "const": 0
    },
    "resume": {
      "const": false
    },
    "artificial_only": {
      "const": true
    }
  },
  "required": [
    "schema",
    "settings",
    "planned",
    "reserved",
    "started_observed",
    "states",
    "complete",
    "pairs",
    "parent_cpu_ns",
    "worker_cpu_ns",
    "total_cpu_ns",
    "wall_ns",
    "failures",
    "all_pair_states",
    "output",
    "mandatory_STOP",
    "retry",
    "resume",
    "artificial_only"
  ],
  "additionalProperties": true
}
