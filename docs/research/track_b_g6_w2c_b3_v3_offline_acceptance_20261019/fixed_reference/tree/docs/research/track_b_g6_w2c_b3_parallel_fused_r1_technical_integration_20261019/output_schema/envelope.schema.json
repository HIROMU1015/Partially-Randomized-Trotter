{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:b3:parallel:v3:envelope",
  "type": "object",
  "properties": {
    "previous": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "string"
    }
  },
  "required": [
    "previous",
    "sha256",
    "payload"
  ],
  "additionalProperties": false
}
