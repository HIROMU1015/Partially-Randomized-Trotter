!artifacts/partial_randomized_pf/screening_results/df_screening_cost_minimization_eps_1.000e-04.json
artifacts/grouped_uwc_pf_qpe
.codex

# BentoSlide/HTML generation work files.  Keep reviewed source plans and final
# deliverables explicit; ignore editor-generated candidate snapshots.
.bento-html-change-*.candidate.html

# Compiled-cost validation: commit compact result JSON, status, plans, and
# Hamiltonian snapshots; keep resumable runtime state and compiler caches local.
artifacts/**/cache/
artifacts/**/checkpoints/
artifacts/**/*_checkpoints/
artifacts/**/*.sqlite
artifacts/**/*.log

