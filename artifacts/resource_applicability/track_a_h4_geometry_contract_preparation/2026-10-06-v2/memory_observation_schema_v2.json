{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_scope",
    "available_bytes",
    "allowed_cpu_count",
    "requested_workers",
    "observation_age_seconds",
    "memory_pressure"
  ],
  "properties": {
    "artifact_scope": {
      "const": "SYNTHETIC_CONTRACT_TEST_ONLY"
    },
    "available_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "allowed_cpu_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "requested_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "observation_age_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "memory_pressure": {
      "type": "boolean"
    }
  }
}
