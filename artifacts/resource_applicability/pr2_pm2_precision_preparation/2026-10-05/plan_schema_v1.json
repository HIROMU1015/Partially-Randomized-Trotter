        "equality_boundary_eligible": false
      }
    },
    "accounting": {
      "const": {
        "alpha_axis": 0.025,
        "axis_map": {
          "real": "cosine",
          "imag": "sine"
        },
        "axis_shots": "ceil(2*B**2/(epsilon/sqrt(2)-b_axis)**2*log(2/alpha_axis))",
        "work": "sum_axis(N_axis*(saved_axis_compiled_mean+P))",
        "ineligible_axis_shots": null,
        "ineligible_matched_work": null,
        "missing_is_zero": false,
        "fixed_C_eff_allowed": false,
        "shot_rule": "sufficient corrected Hoeffding bound, not minimum achievable shots or task impossibility",
        "reference_reproduction": "exact integer axis shots and eligibility; work relative tolerance 1e-12 / absolute 1e-6"
      }
    },
    "metrics": {
      "const": {
        "primary": "rz_count",
        "point_pareto": [
          "rz_count",
          "rz_depth",
          "cx_count",
          "cx_depth",
          "total_depth",
          "circuit_size"
        ],
        "strict_dominance": "all <= and at least one <; retain ties",
        "research_GO_threshold": null
      }
    },
    "P_design": {
      "const": {
        "minimum": 0,
        "maximum": null,
        "unit": "common RZ-equivalent preparation cost per shot",
        "primary_only": true,
        "method": "analytic affine lower envelope at each fixed epsilon, all P>=0, retain boundary ties",
        "P_grid": false,
        "actual_preparation_compile": false,
        "candidate_specific_preparation": false
      }
    },
    "uncertainty": {
      "const": {
        "sample_source": "saved paired cosine/sine trajectory costs only",
        "sample_covariance_denominator": "n-1 (unbiased sample variance/covariance)",
        "work_SE": "sqrt((N_real**2*scc+N_imag**2*sss+2*N_real*N_imag*scs)/n)",
        "P_changes_sampling_SE": false,
        "engineering_interval": "point +/- 2SE",
        "deterministic_variance": "exact nonrandom cost; absent SE is not missing stochastic variance",
        "formal_CI": false,
        "familywise_winner_guarantee": false,
        "interval_ranking_rule": "overlap does not resolve a winner; point frontier remains descriptive"
      }
    },
    "future_outputs": {
