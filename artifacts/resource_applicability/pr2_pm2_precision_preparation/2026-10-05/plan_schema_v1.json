    },
    "analysis_label": {
      "const": "POSTHOC_SAVED_VALUES_ONLY"
    },
    "evidence_commit": {
      "const": "194cc604b90c56a0e7e949b91b064a4bcfc846da"
    },
    "RQ": {
      "const": "Accuracy eligibility versus measurement-inclusive resource choice in the fixed DF-prefix second-order finite grid"
    },
    "domains": {
      "const": {
        "development": 218,
        "reference_eligible_development": 214,
        "transfer_fixed_five": 5,
        "retain_original_ineligible": true,
